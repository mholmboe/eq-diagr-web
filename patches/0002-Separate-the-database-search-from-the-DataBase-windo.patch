+  //<editor-fold defaultstate="collapsed" desc="componentPosition">
+  /** Where a component chosen by the user goes in the list of selected
+   * components, as in the DataBase window: "H+" first, "e-" after "H+", and
+   * solid components at the end. The order of the components is the order
+   * in the data file.
+   * @param selected the components already selected
+   * @param nSolids the number of solid components among them
+   * @param comp the component to add
+   * @return the position (index) for <code>comp</code> in <code>selected</code> */
+  public static int componentPosition(java.util.List<String> selected, int nSolids, String comp) {
+    int position;
+    if(comp.equals("H+")) {
+        position = 0;
+    } else if(comp.equals("e-")) {
+        position = 0;
+        if(selected.size() >0 && selected.get(0).equals("H+")) {position = 1;}
+    } else {
+        if(Util.isSolid(comp)) {
+            position = -1;
+        } else { //not a solid
+            if(nSolids >0) {
+                position = selected.size() - nSolids;
+            } else { //no selected solid components yet
+                position = -1;
+            }
+        } //solid?
+    } //not H+ or e-
+    if(position == -1) {position = selected.size();}
+    return position;
+  }
