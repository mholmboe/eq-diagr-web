+ /** Reads (from the element-component files) the components (reactants) and
+  * the elements, as {@link #getElements getElements} does, but without
+  * message boxes: problems are reported as exceptions. Element files are not
+  * created if they are missing.
+  * <p>elemCompStringArray[0..2] contains the name-of-the-element (e.g. "C"),
+  * the formula of the component ("CN-"), and the name of the component ("cyanide").
+  * @param dbg print debugging info
+  * @param dataBasesList list of database names to read; databases that do not
+  * exist (and have no element file) are skipped
+  * @param elemCompStringArray  data is returned here (chemical element,
+  * component formula, component name)
+  * @throws ReadElemException if an element file is missing or can not be read */
+  public static void readElements(
+          boolean dbg,
+          java.util.ArrayList<String> dataBasesList,
+          java.util.ArrayList<String[]> elemCompStringArray) throws ReadElemException {
+    if(dbg) {System.out.println("-- readElements(..)");}
+    elemCompStringArray.clear();
+    elemCompStringArray.add(new String[]{"H","H+","hydrogen ion"});
+    for(String dbName : dataBasesList) {
+      java.io.File dbFile = new java.io.File(dbName);
+      boolean binaryDB = dbName.toLowerCase().endsWith(".db");
+      String base = Div.getFileNameWithoutExtension(dbName);
+      java.io.File elemFile;
+      if(binaryDB) {
+        elemFile = new java.io.File(base+".elb");
+      } else { // as AddDataElem.getElemFileName: "elt", else "elm"
+        elemFile = new java.io.File(base+".elt");
+        if(!elemFile.exists() && new java.io.File(base+".elm").exists()) {
+            elemFile = new java.io.File(base+".elm");
+        }
+      }
+      if(!dbFile.exists() && !elemFile.canRead()) {
+        if(dbg) {System.out.println("-- Warning: files \""+dbFile.getName()+"\" and \""+elemFile.getName()+"\" do not exist.");}
+        continue;
+      }
+      if(!elemFile.exists()) {
+        throw new ReadElemException("Can not find the \"element\"-file"+nl+
+                    "for database: \""+dbFile.getName()+"\"."+nl+nl+
+                    "Expected to find file \""+elemFile.getName()+"\".");
+      }
+      if(dbg) {System.out.println("  File \""+elemFile+"\"");}
+      if(binaryDB) {readElemFileBinary(dbg, elemFile, elemCompStringArray);}
+      else {readElemFileText(elemFile, elemCompStringArray);}
+    }
+  } //readElements()
+  //</editor-fold>
