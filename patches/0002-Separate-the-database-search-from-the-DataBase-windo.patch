+  /** @return a database search with the databases and options of this window
+   * @throws DBSearch.SearchException */
+  private DBSearch newSearch() throws DBSearch.SearchException {
+    DBSearch s = new DBSearch(pd.dataBasesList, pd.elemComp, pd.temperature_C, pd.pressure_bar);
+    s.dbg = pc.dbg;
+    s.progName = pc.progName;
+    s.redoxAsk = pd.redoxAsk;
+    s.redoxN = pd.redoxN;
+    s.redoxS = pd.redoxS;
+    s.redoxP = pd.redoxP;
+    s.allSolids = pd.allSolids;
+    return s;
+  }
