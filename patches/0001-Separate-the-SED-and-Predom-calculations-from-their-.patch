+            if (!dispatchArg(arg)) {argErr = true; break;}
+        } // for arg
+    } // if argsList != null
+    String msg;
+    if(actCoeffsModel_InCommandLine == 1 && !Double.isNaN(ionicStrength) && ionicStrength >= 0.) { // for SIT
+        msg = "Error: when using the SIT to calculate activity coefficients,"+nl+
+              "the effective ionic strength has to be calculated at each point."+nl+
+              "Use command-line argument \"-i=-1\".";
+        out.flush();
+        out.println("--------"+nl+msg+nl+"--------");
+        out.flush();
+        if(!doNotStop && display != null) {display.messageBox(msg, 1);}
