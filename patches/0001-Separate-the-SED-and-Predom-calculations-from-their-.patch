+//<editor-fold defaultstate="collapsed" desc="prepareCalculations">
+  /** returned by {@link #prepareCalculations() prepareCalculations}: ready to calculate */
+  static final int PREPARED = 0;
+  /** returned by {@link #prepareCalculations() prepareCalculations}: the
+   * calculations can not start, the user may change the input and try again */
+  static final int NOT_PREPARED = 1;
+  /** returned by {@link #prepareCalculations() prepareCalculations}: the
+   * calculations can not start, and trying again would fail as well */
+  static final int NOT_PREPARED_NO_RETRY = 2;
+
+  /** Prepares the calculations for the data file read last: temperature,
+   * pressure and ionic strength, the concentrations at each calculation step,
+   * the activity coefficient model, and the plot (and table) output.
+   * The calculations are then made by {@link #calculate calculate}.
+   * @return PREPARED, NOT_PREPARED or NOT_PREPARED_NO_RETRY */
+  int prepareCalculations() {
+    if(dbg) {out.println("--- doCalculations()");}
+    diag.fractionThreshold = threshold;
+    //---- Check if "EH" is needed -----------
+    if(diag.Eh &&
+            diag.pInX != 3 && diag.plotType != 5) { //plotType=5: pe in Y-axis
+        boolean peGiven = false;
+        for(int i =0; i < cs.Na; i++) {
+            if(Util.isElectron(namn.identC[i]) &&
+                concs.kh[i] ==2) { // kh=2  logA given
+                    peGiven = true; break;}
+        } //for i
+        if(!peGiven) {diag.Eh = false;}
+    }
+    //--- temperature & pressure ------------------------
+    concs.temperature = readTemperature();
+    concs.pressure = readPressure();
+    if(Double.isNaN(concs.temperature)){
+        String msg = "";
+        if(diag.Eh) {msg = "\"Error: Need to plot Eh values but no temperature is given.";}
+        else if(calcActCoeffs)  {msg = "\"Error: activity coefficient calculations required but no temperature is given.";}
+        if(!msg.isEmpty()) {
+            showErrMsgBx(msg,1);
+            return NOT_PREPARED;
+        }
+    }
+    // decide if the temperature should be displayed in the diagram
+    if(!diag.Eh && !calcActCoeffs) {
+        if(dbg) {out.println(" (Note: temperature not needed in the diagram)");}
+    } else {
+        double pSat;
+        try {pSat= lib.kemi.H2O.IAPWSF95.pSat(concs.temperature);}
+        catch (Exception ex) {
+            out.println("\"IAPWSF95.pSat\": "+ex.getMessage());
+            out.println("Calculations cancelled.");
+            return NOT_PREPARED_NO_RETRY;
+        }
+        if(Double.isNaN(concs.pressure)){concs.pressure = 1.;}
+        if(concs.temperature <= 99.61) {
+            if(concs.pressure < 1.) {
+                out.println("tC = "+concs.temperature+", pBar = "+concs.pressure+", setting pBar = 1.");
+            }
+            concs.pressure = Math.max(1.,concs.pressure);
+        }
+        // if pressure = 1 bar and temperature = 0, set temperature to 0.01 C (tripple point of water)
+        if(concs.pressure >0.99999 && concs.pressure < 1.00001 && Math.abs(concs.temperature) < 0.001) {concs.temperature = 0.01;}
+        if(concs.temperature <= 373.95) { // below critical point
+            if(concs.pressure < (pSat*0.999)) {
+                out.println("tC = "+concs.temperature+", pBar = "+concs.pressure+",  setting pBar = "+(float)pSat);
+                concs.pressure = pSat;
+            }
+        }
+    }
+    if(diag.Eh) {peEh = (ln10*8.31446d*(concs.temperature+273.15d)/96484.56d);} else {peEh = Double.NaN;}
+    // nbr of calculation steps
+    // (the scroll bar in the SED window has the range NSTP_MIN to NSTP_MAX)
+    if(!dbg) {
+        nSteps = Math.max(NSTP_MIN,Math.min(NSTP_MAX,nSteps));
+    }
+    final int nSteps1 = nSteps + 1;
+    if(dbg) {out.println(" "+nSteps1+" caculation points"+nl+
+            "ionic strength = "+ionicStrength+nl+
+            "temperature = "+(float)concs.temperature+", pressure = "+(float)concs.pressure+nl+
+            "max relative mass-balance tolerance = "+(float)tolHalta+nl+
+            "activity coefficient tolerance = "+(float)tolHaltaLogF);}
+
+    // ---------------------------------------
+    // get an instance of Plot
+    plot = new Plot(this, err, out);
+    //---- set up some arrays
+    plot.preparePlot(ch);
+    // ---------------------------------------
+
+    String msg;
+    // ionic strength
+    diag.ionicStrengthInput = ionicStrength;  // set ionic strength to that given by the user
+    if(!diag.aquSystem && ionicStrength != 0) {
+        msg = "File: "+inputDataFile.getName()+nl+
+              "Warning: This does not appear to be an aqueous system,"+nl+
+              "and yet you give a value for the ionic strength?";
+        if(!showErrMsgBxCancel(msg, 1)) {
+            out.println("--- Cancelled by the user ---");
+            return NOT_PREPARED;
+        }
+    }
+
+    // model to calculate ion activity coefficients
+    if(calcActCoeffs) {
+        concs.activityCoeffsModel = actCoeffsModel;
+        concs.activityCoeffsModel = Math.min(NBR_ACT_COEFFS_MODELS-1,
+                                        Math.max(0,concs.activityCoeffsModel));
+    } else {
+        concs.activityCoeffsModel = -1;
+    }
+    // height scale for texts in the diagram
+    // (the scroll bar in the SED window has values 3 to 100, that is,
+    // 0.3 to 10; the integer division rounds the value down)
+    tHeight = Math.max(3,Math.min(100,Math.round((float)(10*tHeight))))/10;
+    tHeight = Math.min(10.d,Math.max(tHeight, 0.3));
+
+    int j;
+    // ---- Store given conc. ranges in array bt[Na][nSteps+1]
+    bt = new double[cs.Na][nSteps1];
+    for(j =0; j < cs.Na; j++) {
+        if(dgrC.hur[j] ==1 || dgrC.hur[j] ==4) { //T or LA
+            for(int n =0; n < bt[0].length; n++) {bt[j][n] = dgrC.cLow[j];}
+        } //if T or LA
+        else {  //if TV, LTV or LAV
+            double stepX =(dgrC.cHigh[j] - dgrC.cLow[j]) / nSteps;
+            bt[j][0] = dgrC.cLow[j];
+            for(int n =1; n < (bt[0].length-1); n++) {bt[j][n] = bt[j][n-1] + stepX;}
+            bt[j][nSteps] = dgrC.cHigh[j]; // to avoid rounding errors
+            if(dgrC.hur[j] ==3) { // LTV
+                for(int n =0; n < bt[0].length; n++)
+                    {bt[j][n] = Math.exp(ln10*bt[j][n]);}
+            } //if LTV
+        }  //if TV, LTV or LAV
+    } //for j
+
+    // check POS and NEG with the Tot.Conc. given in the input
+    for(j =0; j < cs.Na; j++) {
+        if(concs.kh[j] == 2) {continue;} //only it Tot.conc. is given
+        if((!pos[j] && !neg[j]) ) { // || cs.nx ==0
+            msg = "Error: for component \""+namn.identC[j]+"\" give Log(Activity)";
+            if(dgrC.hur[j] !=1) { // not "T", that is: "TV" or "LTV"
+                msg = msg+" to vary";}
+            showErrMsgBx(msg,1);
+            return NOT_PREPARED;
+        } //if Nx =0 or (!pos[] & !neg[])
+        /** // this is done in HaltaFall...
+        if(!(pos[j] && neg[j]) && (pos[j] || neg[j])) {
+            if(dgrC.hur[j] !=3 &&  //not LTV
+               dgrC.cLow[j]==0 && (Double.isNaN(dgrC.cHigh[j]) || dgrC.cHigh[j]==0)) {
+                    //it is only POS or NEG and Tot.Conc =0
+                    for(int n =0; n < bt[0].length; n++) {bt[j][n] = -9999.;}
+                    concs.kh[j] =2; //kh=2 means logA given
+                    if(dbg) {out.println("Can not calculate mass-balance for for component \""+namn.identC[j]+"\""+nl+
+                        "   its log(activity) will be set to -9999.");}
+            }
+        }
+        // */
+    } //for j
+
+    calculationStart = System.nanoTime();
+
+    msg = "Starting the calculations...";
+    out.println(msg);
+    if(consoleOutput) {System.out.println(msg);}
+
+    // ---- Make an instance of Factor
+    String userHome = System.getProperty("user.home");
+    concs.ionicStr = diag.ionicStrengthInput;
+    try{
+        factor = new Factor(ch, pathApp, userHome, pathDef.toString(), out);
+        if(concs.activityCoeffsModel == 1) {
+            factor.readSITdataFiles();
+        }
+    } catch (Exception ex) {
+        showErrMsgBx(ex.getMessage(),1);
+        calcActCoeffs = false; diag.ionicStrengthInput = Double.NaN;
+        concs.activityCoeffsModel = -1;
+        concs.phi = Double.NaN; concs.sumM = Double.NaN; concs.electricBalance = Double.NaN;
+    }
+    out.flush();
+    // ---- print information on the model used for activity coefficients
+    if(factor != null) {
+        try {factor.factorPrint(dbg,out);}
+        catch (Exception ex) {showErrMsgBx(ex.getMessage(),1); calcActCoeffs = false; diag.ionicStrengthInput = Double.NaN;}
+    }
+    if(factor == null) {
+        out.println("Calculations cancelled.");
+        return NOT_PREPARED_NO_RETRY;
+    }
+    
+    // ---- table output?
+    if(inputDataFile == null) {tableOutput = false;}
+    if(tableOutput) {
+        table = new Table(this, err, out);
+        String txt = inputDataFile.getAbsolutePath();
+        if(tblExtension == null) {tblExtension = "";}
+        if(tblExtension.startsWith(".")) {tblExtension = tblExtension.substring(1);}
+        String tableFileN = txt.substring(0,txt.length()-4).concat(".").concat(tblExtension);
+        java.io.File outputTableFile = new java.io.File(tableFileN);
+        if(!table.tableHeader(ch, outputTableFile)) {
+            table = null;
+            tableOutput = false;
+        }
+    }
+
+    // ---- Initialize variables
+    concs.dbg = dbgHalta;
+    concs.cont = false;
+    concs.tol = tolHalta;
+    concs.tolLogF = tolHaltaLogF;
+    for(j =0; j < cs.Na; j++) {
+        if(concs.kh[j] == 1) {
+            concs.tot[j]=bt[j][0];
+            concs.logA[j]=-10;
+            if(concs.tot[j]>0) {concs.logA[j] = Math.log10(concs.tot[j]) -3;}            
+        }
+        else {concs.logA[j]=bt[j][0];}
+    } // for j
+
+    cancelled = false;
+    return PREPARED;
+  } //prepareCalculations()
+//</editor-fold>
+
+  //<editor-fold defaultstate="collapsed" desc="calculate">
+  /** Makes the HaltaFall calculations at each point along the X-axis, after
+   * {@link #prepareCalculations() prepareCalculations}. The SED window runs
+   * this on a worker thread (SwingWorker); it may be stopped from another
+   * thread with {@link #cancel() cancel}.
+   * @param progress if not null, it is given the number of each point
+   * (1 to nSteps+1) before it is calculated
+   * @return false if HaltaFall could not be started, true otherwise
+   * (see also {@link #calculationsOK() calculationsOK}) */
+  boolean calculate(java.util.function.IntConsumer progress) {
+    getHaltaInstanceOK = true;
+    haltaError = false;
+    nbrTooLargeConcs = 0;
+    nbrHaltaErrors = 0;
+    nbrHaltaUncertain = 0;
+    failuresMsg.setLength(0);
+    //--- do the HaltaFall calculations
+    // create an instance of class HaltaFall
+    h = null;
+    try {h = new HaltaFall(cs,factor, out);}
+    catch (Chem.ChemicalParameterException ex) { // this should not occur, but you never know
+        showErrMsgBx(ex);
+        getHaltaInstanceOK = false; // skip the rest of the thread
+    }
+    if(!getHaltaInstanceOK) {return false;}
+    // set ionic strength to that given by the user. If it is less than zero
+    // it will be calculated by Factor and the value of concs.ionicStrCalc
+    // will be changed when HaltaFall has finished the calculation
+    concs.ionicStr = diag.ionicStrengthInput;
+
+    int nStepX1, j;
+    double tolHalta0 = concs.tol;
+    double tolHaltaLogF0 = concs.tolLogF;
+    final String f = "--- Calculation problem in \"HaltaFall.haltaCalc\" at point=%d, x=%7.5f"+nl+"%s";
+    nStepX = -1;
+    do_loopX:
+    do {  // -------------------------------------- Loop for X-axis
+        //if needed for debugging: sleep some milliseconds (wait) at each calculation point
+        //try {Thread.sleep(500);} catch(Exception ex) {}
+        nStepX++;
+        // --- input data for this calculation point
+        for(j =0; j < cs.Na; j++) {
+            if(dgrC.hur[j] >1 && dgrC.hur[j] !=4) { //TV, LTV or LAV
+                if(concs.kh[j] == 1) {concs.tot[j]=bt[j][nStepX];}
+                else {concs.logA[j]=bt[j][nStepX];}
+            }
+        }
+        nStepX1 = nStepX+1;
+        if(progress != null) {progress.accept(nStepX1);}
+        if(nStepX == 0 && (dbg || concs.dbg > Chem.DBGHALTA_DEF))
+                out.println("Starting calculation point: "+nStepX1+" (of "+(nSteps+1)+"), x="+(float)bt[diag.compX][nStepX]);
+
+        // ------ print debug output from HaltaFall only for the first two points (nStepX = 0 and 1) ------
+        if(nStepX <= 0) {
+            /** // ########## ---------- ##########  ---------- ########## ##?##
+                concs.dbg = 6;
+                out.println("---- Note:  nStepX="+nStepX+"  (debug) ----");
+            //     ########## ---------- ##########  ---------- ########## ##?## */
+        } else {
+            concs.dbg = Chem.DBGHALTA_DEF;
+            /** // ########## ---------- ##########  ---------- ########## ##?##
+            j = diag.compX;
+            if(Math.abs(bt[j][nStepX]-1.6)<0.005) {
+                concs.dbg = 5;
+                out.println("---- Note: x="+(float)bt[j][nStepX]+",  (debug) ---- nStepX="+nStepX);
+            }   // ########## ---------- ##########  ---------- ########## ##?## */
+        }
+
+        // --- HaltaFall: do the calculations
+        //     calculate the equilibrium composition of the chemical system
+        try {
+            concs.tol = tolHalta0;
+            concs.tolLogF = tolHaltaLogF0;
+            h.haltaCalc();
+            if(concs.isErrFlagsSet(2) || concs.isErrFlagsSet(6)) {
+                // too many iterations when solving the mass balance equations
+                // or activity coeff. did not converge
+                do {
+                    concs.tol = concs.tol * 0.1; // decrease tolerance and try again
+                    if(dbg || concs.dbg > Chem.DBGHALTA_DEF) {
+                        out.println(concs.errFlagsGetMessages()+nl+
+                                "  decreasing tolerance to: "+(float)concs.tol+" and trying again.");
+                    }
+                    h.haltaCalc();
+                } while ((concs.isErrFlagsSet(2) || concs.isErrFlagsSet(6)) && concs.tol >= 1e-12);
+                concs.tol = tolHalta0;
+                concs.tolLogF = tolHaltaLogF0;
+                if(dbg || concs.dbg > Chem.DBGHALTA_DEF) {
+                    out.println("Restoring tolerance to: "+(float)tolHalta0+" for next calculations.");
+                }
+            }
+            if(concs.isErrFlagsSet(3)) { // failed to find a satisfactory combination of solids
+                if(dbg || concs.dbg > Chem.DBGHALTA_DEF) {
+                    out.println("Failed to find a satisfactory combination of solids. Trying again...");
+                }
+                concs.cont = false;      // try again
+                h.haltaCalc();
+            }
+        }
+        catch (Chem.ChemicalParameterException ex) {
+            String ms = "Error in \"HaltaFall.haltaCalc\", "+ex.getMessage()+nl+
+                    "   at point: "+nStepX1+"  x="+bt[diag.compX][nStepX]+nl+
+                    Util.stack2string(ex);
+            showErrMsgBx(ms, 1);
+            haltaError = true;
+            break; // do_loopX;
+        }
+        // ---
+
+        if(cancelled) {break;} // do_loopX  // user request exit?
+
+        out.flush();
+
+        if(concs.isErrFlagsSet(1)) {nbrHaltaUncertain++;}
+        if(concs.isErrFlagsSet(5)) {nbrTooLargeConcs++;}
+        if(concs.isErrFlagsSet(2) || concs.isErrFlagsSet(3) || concs.isErrFlagsSet(4)
+                            || concs.isErrFlagsSet(6)) {
+            nbrHaltaErrors++;
+            if(failuresMsg.length() >0) {failuresMsg.append(nl);}
+            failuresMsg.append(String.format(engl,f,nStepX1,(float)bt[diag.compX][nStepX],concs.errFlagsGetMessages()));
+        }
+
+        if(dbg) h.printConcs(out);
+
+        if(cancelled) {break;} // do_loopX  // user request exit?
+
+        // store the results for later plotting (and table output)
+        plot.storePlotData(nStepX, ch);
+        if(table != null) {table.tableBody(nStepX, ch);}
+    } while (nStepX < nSteps); // -------------------------- Loop for X-axis
+    return true;
+  } //calculate()
+
+  /** Stops the calculations; may be called from another thread */
+  void cancel() {
+    cancelled = true;
+    if(h != null) {h.haltaCancel();}
+  }
+
+  /** @return true if the last calculations finished without errors */
+  boolean calculationsOK() {return getHaltaInstanceOK && !haltaError;}
+
+  /** @return the number of points where HaltaFall failed in the last calculations */
+  public int failedPoints() {return nbrHaltaErrors;}
+
+  /** @return the time taken by the last calculations, in milliseconds */
+  public long calculationMillis() {return calculationTime;}
+
+  /** After {@link #calculate calculate}: reports problems, writes the plot
+   * file (and closes the table file) unless HaltaFall failed. */
+  void finishCalculations() {
+        String msg;
+        calculationTime = (System.nanoTime() - calculationStart)
+                    /1000000; //convert nano seconds to milli seconds
+        if(!haltaError) {
+            msg = "";
+            if(nbrTooLargeConcs > 0) {
+                int percent = nbrTooLargeConcs*100 / (nSteps+1);
+                if(percent > 0) {
+                    msg = percent+" % of the calculated points had some"+nl+
+                          "concentrations > "+(int)h.UNREASONABLE_CONC+" (molal); impossible in reality."+nl+nl;
+                    if(calcActCoeffs) {msg = msg + "The activity coefficients are then WRONG"+nl+
+                          "and the results unrealistic."+nl;}
+                    else {msg = msg + "These results are unrealistic."+nl;}
+                }
+            }
+            if(nbrHaltaErrors <= 0 && nbrHaltaUncertain >0 && dbg) {
+                if(msg.length() >0) msg = msg+nl;
+                msg = msg+String.format("%d",nbrHaltaUncertain).trim()+" point(s) with round-off errors (not within tolerance).";
+            }
+            if(nbrHaltaErrors >0) {
+                if(msg.length() >0) msg = msg+nl;
+                msg = msg+String.format("Calculations failed for %d",nbrHaltaErrors).trim()+" point(s).";
+            }
+            if(msg.length() >0) {showErrMsgBx(msg, 1);}
+            if(nbrHaltaErrors >0 && failuresMsg != null && failuresMsg.length() >0) {// failuresMsg should not be empty...
+                out.println(LINE);
+                out.println(failuresMsg);
+                out.println(LINE);
+            }
+
+            out.println("Saving plot file \""+outputPltFile.getAbsolutePath()+"\"...");
+            try{plot.drawPlot(outputPltFile, ch);}
+            catch (Exception ex) {
+              showErrMsgBx("Error: "+ex.getMessage()+nl+
+                  "while saving plot file \""+outputPltFile.getAbsolutePath()+"\"", 1);
+            }
+            if(outputPltFile != null && outputPltFile.getName().length()>0) {
+                String msg3 = "Saved plot file: \""+outputPltFile.getAbsolutePath()+"\"";
+                out.println(msg3);
+                System.out.println(msg3);
+            }
+            if(table != null) {table.tableClose();}
+        } //haltaError?
+        msg = "--- Calculated "+(nSteps+1)+" points, wall-clock time="+millisToShortDHMS(calculationTime);
+        out.println(msg);
+        System.out.println(msg);
+  } //finishCalculations()
+  //</editor-fold>
+
+  //<editor-fold defaultstate="collapsed" desc="set_tol">
+/** find the closest item in the list of tolerances and use it, as the
+ * tolerances combo box in the SED window does */
+  private void set_tol() {
+    double w0, w1;
+    int listItem =0;
+    int listCount = TOLERANCES.length;
+    for(int i =1; i < listCount; i++) {
+      w0 = Double.parseDouble(TOLERANCES[i-1]);
+      w1 = Double.parseDouble(TOLERANCES[i]);
+      if(tolHalta >= w0 && i==1) {listItem = 0; break;}
+      if(tolHalta <= w1 && i==(listCount-1)) {listItem = (listCount-1); break;}
+      if(tolHalta < w0 && tolHalta >=w1) {
+        if(Math.abs(tolHalta-w0) < Math.abs(tolHalta-w1)) {
+            listItem = i-1;
+        } else {
+            listItem = i;
+        }
+        break;
+      }
+    } //for i
+    tolIndex = listItem;
+    tolHalta = 0.01/Math.pow(10,listItem);
+  } //set_tol()
+
+  /** the item in TOLERANCES closest to tolHalta */
+  int tolIndex = 2;
+//</editor-fold>
+
