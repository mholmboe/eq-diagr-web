+  /** Makes a diagram without a window, as <code>SED -d=file.dat [options]</code>
+   * does on the command line: reads the command-line arguments and the data
+   * file, makes the calculations and writes the plot file (and the table
+   * file if requested).
+   * @param args the command-line arguments
+   * @return true if the plot file was written */
+  public boolean run(final String[] args) {
+    boolean rev0 = false;
+    if(args != null) {
+        for(String arg : args) { // as in SED.main
+            if (arg.startsWith("-dbg") || arg.startsWith("/dbg")) {dbg = true;}
+            else if (arg.equalsIgnoreCase("-keep") || arg.equalsIgnoreCase("/keep")) {doNotExit = true;}
+            else if (arg.equalsIgnoreCase("-nostop") || arg.equalsIgnoreCase("/nostop")) {doNotStop = true;}
+            else if (arg.equalsIgnoreCase("-rev") || arg.equalsIgnoreCase("/rev")) {rev0 = true;}
+        }
+    }
+    if(pathDef.length() <= 0) {setPathDef();}
+    if(!start(rev0, args)) {return false;}
+    if(!inputDataFileInCommandLine) {
+        showMsg("No input data file given (command-line option \"-d=\").", 1);
+        return false;
+    }
+    if(prepareCalculations() != PREPARED) {return false;}
+    boolean ok = calculate(null);
+    if(ok) {finishCalculations();}
+    out.println(LINE);
+    System.out.println(LINE);
+    return ok && calculationsOK() && outputPltFile.exists();
+  } //run
