%%BoundingBox: -11 -6 560 398
%%EndComments
% to change the "BoundingBox" given above: add margins in cm * 28.4
%%BeginProlog
% ------- Prolog:  defining procedures and variables -------
/ChemEqDict 60 dict def   % create a dictionary
ChemEqDict begin          % push dictionary in dictionary stack
/Mv {moveto} def
/Ln {lineto} def
/_sn {stroke newpath} def
/_csn {closepath stroke newpath} def
/_setWidth {/linWidth exch def linWidth setlinewidth}  def
% --- dash-line types:
/Lt0 {stroke linWidth setlinewidth [] 0 setdash} def
/Lt1 {stroke linWidth setlinewidth [30 10] 0 setdash} def
/Lt2 {stroke linWidth setlinewidth [15 15] 0 setdash} def
/Lt3 {stroke linWidth setlinewidth [5 10] 0 setdash} def
/Lt4 {stroke linWidth setlinewidth [30 10 5 10] 0 setdash } def
/Lt5 {stroke linWidth setlinewidth [15 10 5 10] 0 setdash} def
%--------------------  Font related stuff:  ---------------------------------
/rShow {dup stringwidth pop 0 exch        % right-show
        sub 0 rmoveto show} def
/lShow {show} def                         % left-show
/cShow {dup stringwidth pop -2 div -0.5   % center-show (both
        getSize siz mul rmoveto show} def %  vertically & horizontally)
/_angle 0 def                 % angle to rotate text
/TxtRotate                    % Procedure to rotate text. Usage:
    {gsave                    %   /_angle nn def  TxtRotate
     currentpoint translate   %   x y moveto (text1) show
     _angle rotate} def       %   x y moveto (text2) show  grestore
/fontScale  1.40 def
/_setSize     % scale current font (parameter: font size in 0.01 cm units)
          {fontScale mul /UserFont currentfont def
           /UserFont findfont exch scalefont setfont} def
/getSize  {gsave newpath 0 0 moveto (X)       % find current font size
           true charpath flattenpath pathbbox %   and store result in "siz"
           /siz exch def pop pop pop grestore} def
%----------------------------------------------------------------------------
%          -----        additions for PostScript output            -----
%          -----  which allow printing math and chemical formulas  -----
%----------------------------------------------------------------------------
% ---- super/sub-scripts.
%      Both "^" and "_^" take two arguments: the string to output and
%      the vertical shift (positive or negative as fraction of letter
%      size). The difference: "_^" does not advance the cursor (allowing
%      subs- and super-scripts on the same letter).
%      For example, to output UO2(CO3)3-4:
%        (UO) show (2) -0.5 ^ (\(CO) show (3) -0.5 ^
%        (\)) show (3) -0.5 ^ (4-) 0.5 _^
%      "_f" takes one argument (spacing as fraction of letter size)
%      and moves the cursor forward or backward. Useful in math formulas.
/^  {/regFont currentfont def /ssFont currentfont [.7 0 0 .7 0 0] makefont def
    getSize dup 0 exch siz mul rmoveto ssFont setfont
    exch show 0 exch siz neg mul rmoveto regFont setfont } def
/_^ {/regFont currentfont def /ssFont currentfont [.7 0 0 .7 0 0] makefont def
    getSize dup 0 exch siz mul rmoveto ssFont setfont
    exch dup stringwidth pop neg exch show 
    0 rmoveto 0 exch siz neg mul rmoveto regFont setfont } def
/_f {getSize siz mul 0 rmoveto} def
%
% ----- printing symbols and/or change to Bold and Italic.
%  *1*  bold, italics, etc:  "_norm", "_bold", "_em" and "_sym" take
%       no arguments and they are used before a "(text) show".
%       Because the Roman fonts use here the ISOLatin1 encoding,
%       one can plot some symbols with them.  Examples:
%           _norm (normal) show _bold (bold) show _em (italics) show _norm
%           _norm (T=25 \260C, [Cu]=1\265M) show
%  *2*  the Symbol font may be used with octal codes (\nnn).
%       Example formula (- delta-r-Cp0m):
%              _sym (-\104) show _norm (r) -0.4 ^ 0.05 _f _em (C) show
%              _sym (\260) 0.3 _^ _norm (p,m) -0.4 ^
%       another example (log_10 pCO2(g)):
%              _norm (log) show (10) -0.4 ^ 0.1 _f _em (p) show
%              _norm (CO) -0.4 ^ (2) -0.8 ^ (\(g\)) -0.4 ^
%       Tables with the octal encoding vectors for the Roman and Symbol
%       fonts are given in PostScript manuals.
%
/_norm     {/Helvetica findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding ISOLatin1Encoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_bold     {/Helvetica-Bold findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding ISOLatin1Encoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_em       {/Helvetica-Oblique findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding ISOLatin1Encoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_normS    {/Helvetica findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding StandardEncoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_boldS    {/Helvetica-Bold findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding StandardEncoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_emS      {/Helvetica-Oblique findfont dup length dict begin
            {1 index /FID ne {def} {pop pop} ifelse} forall
            /Encoding StandardEncoding def currentdict end
            /UserFont exch definefont pop
            getSize /UserFont findfont 1.43 siz mul scalefont setfont} def
/_sym      {getSize /Symbol findfont 1.43 siz mul scalefont setfont} def
%
end   % pop ChemEqDict from dictionary stack
% ------------------------------- end Prolog --------------------------------
%%EndProlog
